VITE_LOGIN_USERNAME=change-this
VITE_LOGIN_PASSWORD=change-this

# Select the backend used by the React app: php or node.
VITE_API_BACKEND=php
VITE_NODE_API_BASE_URL=/api

# Public account identifier used to populate the frontend user list.
VITE_USER_ADMIN_PNS_EDY_USERNAME=change-this

# Keep account passwords server-side; never prefix these with VITE_.
BOT_USER_ADMIN_PNS_EDY_PASSWORD=change-this

# Node API server/session configuration for local development.
NODE_API_HOST=127.0.0.1
NODE_API_PORT=4001
SESSION_SECRET=replace-with-a-long-random-secret
NODE_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use NODE_API_CORS_ORIGINS=* to allow every origin with credentials (unsafe).
